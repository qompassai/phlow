// Example PTX kernel used as a test fixture by phlow-compute-cuda.
// Original text written for this crate; it follows the public PTX ISA
// syntax but is not copied from any upstream kernel.
.version 8.0
.target sm_80
.address_size 64

.visible .entry vector_add_kernel(
    .param .u64 vector_add_kernel_param_0,
    .param .u64 vector_add_kernel_param_1,
    .param .u64 vector_add_kernel_param_2,
    .param .u32 vector_add_kernel_param_3
)
{
    .reg .u32 %r<4>;
    .reg .u64 %rd<8>;
    .reg .f32 %f<4>;

    ld.param.u64 %rd1, [vector_add_kernel_param_0];
    ld.param.u64 %rd2, [vector_add_kernel_param_1];
    ld.param.u64 %rd3, [vector_add_kernel_param_2];
    ld.param.u32 %r1, [vector_add_kernel_param_3];
    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.u32 %r2, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra DONE;
    mul.wide.u32 %rd4, %r2, 4;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd6, %rd2, %rd4;
    add.u64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    add.f32 %f3, %f1, %f2;
    st.global.f32 [%rd7], %f3;
DONE:
    ret;
}
